# ------------------------------------------------------------
#  Panel de usuario — plantilla de variables de entorno
#  Copia este archivo como .env y coloca tus propios valores:
#      cp .env.example .env
# ------------------------------------------------------------

# Salt secreto usado para cifrar/descifrar el correo del usuario.
# Genera uno con:  php -r "echo bin2hex(random_bytes(32));"
PANEL_SALT="cambia_este_valor_por_uno_aleatorio_y_secreto"

# Algoritmo de cifrado simétrico (opcional, por defecto aes-256-cbc).
PANEL_CIFRADO=aes-256-cbc
